{
  "name": "babyfoon-web",
  "version": "1.0.0",
  "description": "Babyfoon-webapp met live audio en video via WebRTC. Werkt op computer en mobiel (3G/4G/5G/wifi).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node test/e2e.js",
    "test:serverless": "node test/e2e-serverless.js",
    "test:reconnect": "node test/e2e-reconnect.js",
    "test:timing": "node test/e2e-timing.js",
    "build": "node build.js",
    "lint": "bash -c 'node -c server.js && for f in serverless/js/*.js public/js/*.js test/*.js; do node -c \"$f\" || exit 1; done'",
    "test:oldbrowser": "node test/e2e-oldbrowser.js",
    "test:media": "node test/e2e-media.js",
    "test:audit": "node test/e2e-audit.js",
    "test:i18n": "node test/i18n-parity.js",
    "test:background": "node test/e2e-background.js",
    "test:stability": "node test/e2e-stabiliteit.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "peer": "^1.0.2",
    "playwright": "^1.40.0"
  },
  "license": "MIT"
}
