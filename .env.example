# ---- App ----
# Public base URL. QR codes and vCards are built against this.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Database (optional for the demo) ----
# When set, wire src/lib/store.ts to Prisma. Without it, a JSON file-store
# fallback runs so the full publish -> scan loop still works locally.
# DATABASE_URL="postgresql://user:pass@localhost:5432/cardstudio"

# ---- Auth.js (LinkedIn OIDC) ----
# Required to enable "Connect with LinkedIn" (§4.4). Scopes: openid profile email.
# Register an app at https://www.linkedin.com/developers/ and add
# {APP_URL}/api/auth/callback/linkedin as an authorized redirect URL.
AUTH_SECRET=""                 # `openssl rand -base64 32`
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# Flip on to surface the LinkedIn button in the editor UI.
NEXT_PUBLIC_LINKEDIN_ENABLED="false"

# ---- Storage (optional) ----
# S3-compatible or Vercel Blob for re-hosted LinkedIn photos + exports (§4.4).
# BLOB_READ_WRITE_TOKEN=""
